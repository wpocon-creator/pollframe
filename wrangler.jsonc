{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "de",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "logpush": false,
  "triggers": { "crons": ["17 3 * * *"] },
  "ratelimits": [
    {
      "name": "SECURITY_BURST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "vars": {
    "ACCOUNTS_ENABLED": "true",
    "PRIVATE_RESULTS_ENABLED": "true",
    "WEB_ANALYTICS_TOKEN": "3c576ccf9ab3417b8a6a33bb8b22bb07"
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "pollframe-accounts",
      "database_id": "24b888dc-f834-487d-b4d9-2fc9a61f9a48",
      "migrations_dir": "migrations/accounts"
    }
  ],
  "routes": [
    { "pattern": "pollframe.com", "custom_domain": true },
    { "pattern": "www.pollframe.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/poll-data.json",
      "/regions.json",
      "/state-map-data.json",
      "/uk-summary.json",
      "/spain-summary.json",
      "/data/*",
      "/",
      "/index.html",
      "/embed.html",
      "/robots.txt",
      "/sitemap.xml",
      "/pf-ops/*",
      "/countries",
      "/studio",
      "/studio/*",
      "/de/*",
      "/uk",
      "/uk/*",
      "/es",
      "/es/*",
      "/sources",
      "/editorial-standards"
    ],
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BUG_REPORT_STORE", "class_name": "BugReportStore" },
      { "name": "ANALYTICS_STORE", "class_name": "AnalyticsStore" },
      { "name": "ELECTION_RESULTS", "class_name": "ElectionResultsStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BugReportStore"] },
    { "tag": "v2", "new_sqlite_classes": ["AnalyticsStore"] },
    { "tag": "v3", "new_sqlite_classes": ["ElectionResultsStore"] }
  ]
}
