{
  "name": "pollframe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:accounts": "node scripts/run-account-lab.mjs",
    "prebuild": "node scripts/repair-source-notices.mjs && node scripts/validate-source-rights.mjs && node scripts/validate-poll-data.mjs && node scripts/generate-seo-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/validate-security.mjs && node scripts/validate-performance.mjs && node scripts/validate-aggregate-analytics.mjs && node --test tests/seo-routes.test.mjs tests/domain-migration.test.mjs tests/seo-content.test.mjs tests/studio-seo.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "preview:worker": "wrangler dev --local --host localhost --ip 127.0.0.1 --port 4177",
    "check": "npm run build",
    "test:browser": "playwright test",
    "qa:quick": "node scripts/qa-lab/run.mjs baseline && node scripts/qa-lab/properties.mjs",
    "qa:matrix": "node scripts/qa-lab/browser.mjs matrix",
    "qa:boundary": "node scripts/qa-lab/stress.mjs",
    "qa:calibrate": "node scripts/qa-lab/browser.mjs sensitivity",
    "qa:offline-contract": "node scripts/qa-lab/offline-contract.mjs",
    "test:studio:unit": "node --test tests/studio-event-layout.test.mjs tests/studio-event-selection.test.mjs tests/studio-event-seed.test.mjs tests/studio-custom-events.test.mjs tests/studio-model.test.mjs tests/studio-style-library.test.mjs tests/poll-calculation-receipt.test.mjs tests/accounts-production.test.mjs tests/account-worker-runtime.test.mjs",
    "test:studio:browser": "playwright test tests/quality-review-september.spec.mjs tests/studio-events-outcomes.spec.mjs tests/studio-event-editing.spec.mjs tests/header-account-responsive.spec.mjs tests/account-ui-quality.spec.mjs tests/studio-font-export.spec.mjs --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop --workers=2",
    "test:update-pipeline": "node --test tests/update-pipeline.test.mjs",
    "test:seo": "node --test tests/seo-routes.test.mjs",
    "test:watchlist-reorder": "node --test tests/watchlist-reorder.test.mjs",
    "data:update": "node scripts/update-poll-data.mjs",
    "data:update:election": "node scripts/update-election-history.mjs",
    "data:update:uk": "node scripts/update-uk-data.mjs",
    "data:update:spain": "node scripts/update-spain-data.mjs",
    "data:update:spain-issues": "node scripts/update-spain-issues.mjs",
    "data:update:spain-regions": "node scripts/update-spain-regions.mjs",
    "data:update:approval": "node scripts/update-approval-data.mjs",
    "data:map": "node scripts/build-state-map-data.mjs",
    "data:validate": "node scripts/repair-source-notices.mjs && node scripts/validate-source-rights.mjs && node scripts/validate-poll-data.mjs",
    "data:review": "node scripts/review-data-changes.mjs",
    "security:check": "node scripts/validate-security.mjs",
    "performance:check": "node scripts/validate-performance.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/bitter": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/merriweather": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-slab": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/urbanist": "5.3.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@react-map/united-kingdom": "1.0.9",
    "@svg-maps/germany": "2.0.0",
    "html-to-image": "1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "better-auth": "1.7.5",
    "cheerio": "1.2.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "5.4.624",
    "undici": "7.29.0",
    "vite": "6.4.3",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "undici": "7.29.0",
    "nanoid": "3.3.18"
  }
}
