{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Storage administration only: no Worker entry point, routes, or public UI.
  "name": "pollframe-account-storage",
  "account_id": "01c29a77a387ffb473bd403bf08ed0f5",
  "compatibility_date": "2026-07-30",
  "d1_databases": [
    {
      "binding": "ACCOUNTS_STAGING_DB",
      "database_name": "pollframe-accounts-staging",
      "database_id": "27b47f20-c612-4f73-b3e4-7645345c2720",
      "migrations_dir": "migrations/accounts"
    },
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "pollframe-accounts",
      "database_id": "24b888dc-f834-487d-b4d9-2fc9a61f9a48",
      "migrations_dir": "migrations/accounts"
    }
  ]
}
